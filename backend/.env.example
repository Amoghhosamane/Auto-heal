# AutoHeal Cloud Environment Configuration

# Operating mode: "demo" (default safe synthetic mode) or "live" (connects to Prometheus and K8s)
OPERATING_MODE=demo

# Application server settings
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","https://auto-heal-one.vercel.app"]

# Database settings
# For demo/local lightweight use: sqlite+aiosqlite:///./autoheal.db
# For PostgreSQL / Docker Compose: postgresql+asyncpg://autoheal:autoheal_secret@localhost:5432/autoheal_db
DATABASE_URL=sqlite+aiosqlite:///./autoheal.db

# Live Monitoring: Prometheus API endpoint
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT_SECONDS=3.0

# Live Orchestration: Kubernetes
KUBE_TARGET_NAMESPACE=default
LIVE_RECOVERY_ENABLED=false
ACTION_COOLDOWN_SECONDS=15
